  <script>
    // Fleet Quick View — Day/Week/Month toggle: swap Google clk / Impr / Pos per period and re-sort by impressions.
    (function () {
      var tbody = document.getElementById('fqv-tbody');
      var toggle = document.getElementById('fqv-period-toggle');
      if (!tbody || !toggle) return;
      var nf = new Intl.NumberFormat('en-GB');
      function apply(period) {
        var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr[data-site]'));
        rows.forEach(function (r) {
          var clk = r.getAttribute('data-c' + period);
          var imp = r.getAttribute('data-i' + period);
          var pos = r.getAttribute('data-p' + period);
          var cC = r.querySelector('[data-col="clicks"]');
          var cI = r.querySelector('[data-col="impr"]');
          var cP = r.querySelector('[data-col="pos"]');
          if (cC) cC.textContent = nf.format(Number(clk || 0));
          if (cI) cI.textContent = nf.format(Number(imp || 0));
          if (cP) cP.textContent = (pos === '' || pos == null) ? '—' : Number(pos).toFixed(1);
        });
        rows.sort(function (a, b) {
          return Number(b.getAttribute('data-i' + period) || 0) - Number(a.getAttribute('data-i' + period) || 0);
        });
        rows.forEach(function (r) {
          tbody.appendChild(r);
          var det = tbody.querySelector('tr[data-detail="' + r.getAttribute('data-site') + '"]');
          if (det) tbody.appendChild(det);
        });
      }
      toggle.querySelectorAll('.fqv-period').forEach(function (btn) {
        btn.addEventListener('click', function () {
          toggle.querySelectorAll('.fqv-period').forEach(function (b) {
            b.classList.remove('bg-indigo-600', 'text-white');
            b.classList.add('text-gray-400');
          });
          btn.classList.add('bg-indigo-600', 'text-white');
          btn.classList.remove('text-gray-400');
          apply(btn.getAttribute('data-period'));
        });
      });
    })();

    // Sortable headers — click any Quick View column header to sort high/low. Arrows (↕ ▲ ▼) show state.
    (function () {
      var tbody = document.getElementById('fqv-tbody');
      if (!tbody) return;
      var table = tbody.closest('table');
      if (!table) return;
      var ths = Array.prototype.slice.call(table.querySelectorAll('thead th'));
      var state = { col: -1, dir: 1 };
      function cellText(row, idx) {
        var c = row.children[idx];
        return c ? (c.textContent || '').trim() : '';
      }
      function toNum(t) {
        if (t === '' || t === '—') return null;
        var n = parseFloat(t.replace(/[,%]/g, ''));
        return isNaN(n) ? null : n;
      }
      function sortBy(idx) {
        state = { col: idx, dir: state.col === idx ? -state.dir : 1 };
        var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr[data-site]'));
        rows.sort(function (a, b) {
          var va = cellText(a, idx), vb = cellText(b, idx);
          var na = toNum(va), nb = toNum(vb), cmp;
          if (na !== null && nb !== null) cmp = na - nb;
          else cmp = va.toLowerCase().localeCompare(vb.toLowerCase());
          return cmp * state.dir;
        });
        rows.forEach(function (r) {
          tbody.appendChild(r);
          var det = tbody.querySelector('tr[data-detail="' + r.getAttribute('data-site') + '"]');
          if (det) tbody.appendChild(det);
        });
        ths.forEach(function (th, i) {
          var ar = th.querySelector('.fqv-arrow');
          if (ar) {
            ar.textContent = i === idx ? (state.dir > 0 ? ' ▲' : ' ▼') : ' ↕';
            ar.className = 'fqv-arrow ' + (i === idx ? 'text-indigo-300' : 'text-gray-600');
          }
        });
      }
      ths.forEach(function (th, i) {
        if (i === 0) return; // skip the ▸ expander column
        th.style.cursor = 'pointer';
        th.classList.add('select-none');
        if (!th.querySelector('.fqv-arrow')) {
          var ar = document.createElement('span');
          ar.className = 'fqv-arrow text-gray-600';
          ar.textContent = ' ↕';
          th.appendChild(ar);
        }
        th.addEventListener('click', function () { sortBy(i); });
      });
    })();
  </script>
</DashboardLayout>
