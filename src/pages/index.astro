---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import YouTubeTile from '../components/YouTubeTile.astro';
import PodcastTile from '../components/PodcastTile.astro';
import ClusterDecisionsTile from '../components/ClusterDecisionsTile.astro';
import ClarityDropoffTile from '../components/ClarityDropoffTile.astro';
import ConversionLeakTile from '../components/ConversionLeakTile.astro';
import FeatureCoverageTile from '../components/FeatureCoverageTile.astro';
import FleetBotHitsTile from '../components/FleetBotHitsTile.astro';
import AiVisibilityTile from '../components/AiVisibilityTile.astro';
import ClicksWithinReachTile from '../components/ClicksWithinReachTile.astro';
import PerSiteEnhancementsTile from '../components/PerSiteEnhancementsTile.astro';
import LeadsSummaryTile from '../components/LeadsSummaryTile.astro';
import LosingClicksTile from '../components/LosingClicksTile.astro';
import TopPagesByClicksTile from '../components/TopPagesByClicksTile.astro';
import clients from '../utils/dashboardClients';
import { statusOf, STATUS_RANK, STATUS_PILL, STATUS_LABEL } from '../utils/siteStatus';
import fs from 'node:fs';
import path from 'node:path';

const clientIds = new Set((clients as any[]).map((c) => c.id));
const inDash = ([id]: [string, any]) => clientIds.has(id);

function loadJson(filename: string) {
  try {
    const filePath = path.join(process.cwd(), 'src', 'data', 'live', filename);
    if (fs.existsSync(filePath)) {
      return JSON.parse(fs.readFileSync(filePath, 'utf-8'));
    }
  } catch {}
  return null;
}

const ga4 = loadJson('ga4.json') || {};
const gsc = loadJson('gsc.json') || {};
const recs = loadJson('recommendations.json') || {};
const uptime = loadJson('uptime.json') || {};
const audit = loadJson('ai_audit.json') || {};
const citations = loadJson('citation_results.json') || {};
const botHits = loadJson('bot_hits.json') || {};
const changelog = loadJson('site_changelog.json') || {};
const bing = loadJson('bing.json') || {};
const crawlActivity = loadJson('crawl_activity.json') || {};
const aioSerp = loadJson('ai_overview_serp.json') || {};
const wins = loadJson('wins_this_week.json') || null;
const manualQueue = loadJson('manual_indexing_queue.json') || null;
const cfCrawls = loadJson('cf_ai_crawls.json') || null;
const contentFreshness = loadJson('content_freshness.json') || null;
const syndication = loadJson('syndication.json') || null;

// Compute total site issues (real fixes count, used for tile that previously mislabelled)
let totalIssues = 0;
for (const c of clients) {
  const crawl = loadJson(`crawl_${c.id}.json`);
  totalIssues += (crawl?.issues?.length || 0);
}

// Build health data per client
const healthData: Record<string, any> = {};
for (const c of clients) {
  const crawl = loadJson(`crawl_${c.id}.json`);
  const r = recs[c.id] || {};
  const g = ga4[c.id] || {};
  const u = uptime[c.id] || {};
  const a = audit[c.id] || {};
  const cit = citations[c.id] || {};
  const bh = botHits[c.id] || {};
  const aio = aioSerp[c.id] || {};
  const cl = changelog[c.id === 'market-invoice' ? 'market-invoice' : c.id === 'seocompare' ? 'seocompare' : 'rank4ai-dashboard'] || {};

  const botTotal = (bh.days || []).reduce((sum: number, d: any) => sum + (d.total || 0), 0);
  const citSummary = cit.summary || {};

  healthData[c.id] = {
    pages: crawl?.pages_crawled || 0,
    // Google SEO
    users: g.overview?.active_users || 0,
    sessions: g.overview?.sessions || 0,
    clicks: gsc[c.id]?.totals?.clicks || 0,
    impressions: gsc[c.id]?.totals?.impressions || 0,
    avgPosition: gsc[c.id]?.totals?.position || null,
    // AI Citations
    citRate: cit.overall_rate || 0,
    citClaude: citSummary.claude?.rate || 0,
    citChatgpt: citSummary.chatgpt?.rate || 0,
    citGemini: citSummary.gemini?.rate || 0,
    // Bing + Copilot — crawl_activity.bing_indexed = last daily snapshot from Bing Webmaster
    bingIndexed: (crawlActivity[c.id] || {}).bing_indexed || 0,
    bingQueries: (bing[c.id] || {}).top_queries?.length || 0,
    // AI Overviews (Google)
    aioDetected: aio.ai_overviews_detected || 0,
    aioTotal: aio.total_queries || 0,
    // Scores
    aiScore: a.overall_score || null,
    recsTotal: r.total || 0,
    recsCritical: r.critical || 0,
    recsHigh: r.high || 0,
    upStatus: u.status || null,
    upMs: u.response_time_ms || null,
    botHits: botTotal,
    lastCommit: cl.recent_commits?.[0]?.message || null,
    lastCommitDate: cl.recent_commits?.[0]?.date?.slice(0, 10) || null,
  };
}

// Get last refresh time from any file
let lastRefresh = '--';
try {
  const recPath = path.join(process.cwd(), 'src', 'data', 'live', 'recommendations.json');
  if (fs.existsSync(recPath)) {
    const recData = JSON.parse(fs.readFileSync(recPath, 'utf-8'));
    const firstClient = Object.keys(recData)[0];
    if (firstClient && recData[firstClient]?.generated_at) {
      lastRefresh = new Date(recData[firstClient].generated_at).toLocaleString('en-GB', {
        day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit'
      });
    }
  }
} catch {}

// Honest "is what you're looking at actually current?" banner. The board is a
// static build, so a viewer can't tell a stale number from a live one — the only
// safe signal is the data-freshness guardrail (check_data_freshness.py), which
// stamps every live/*.json with its real age. Surface the WORST case here on the
// main board (not just /ops) so nobody is ever misled by a stale headline. The
// old "Last refresh" stamp read a single feed and lied when others rotted.
const freshness = loadJson('data_freshness.json') || null;
let freshBanner: { tone: 'ok' | 'warn' | 'bad'; asOf: string; line: string; stale: string[] } | null = null;
if (freshness?.feeds) {
  // Only the curated "core" feeds back numbers shown on this board — judge the
  // banner on those, not the catch-all research dumps (those live on /ops).
  const core = (freshness.feeds || []).filter((f: any) => f.tier !== 'auto');
  const bad = core.filter((f: any) => f.status === 'very_stale' || f.status === 'missing');
  const stale = core.filter((f: any) => f.status === 'stale');
  const asOf = freshness.checked_at
    ? new Date(freshness.checked_at).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })
    : lastRefresh;
  const names = [...bad, ...stale].slice(0, 6).map((f: any) =>
    `${f.label}${f.age_hours != null ? ` (${f.age_hours >= 48 ? Math.round(f.age_hours / 24) + 'd' : Math.round(f.age_hours) + 'h'})` : ''}`);
  if (bad.length) {
    freshBanner = { tone: 'bad', asOf, stale: names,
      line: `${bad.length} core feed${bad.length > 1 ? 's' : ''} dead or very stale${stale.length ? ` · ${stale.length} more stale` : ''} — numbers below may be wrong` };
  } else if (stale.length) {
    freshBanner = { tone: 'warn', asOf, stale: names,
      line: `${stale.length} core feed${stale.length > 1 ? 's' : ''} stale — those numbers are lagging` };
  } else {
    freshBanner = { tone: 'ok', asOf, stale: [],
      line: `All ${core.length} core feeds fresh` };
  }
}

// Full categorised changelog
const fullChangelog = loadJson('full_changelog.json') || [];
const allCommits = fullChangelog;

// Overall stats
const totalRecs = Object.values(healthData).reduce((sum: number, d: any) => sum + d.recsTotal, 0);
const totalCritical = Object.values(healthData).reduce((sum: number, d: any) => sum + d.recsCritical, 0);
const totalClicks = Object.values(healthData).reduce((sum: number, d: any) => sum + d.clicks, 0);
const totalImpressions = Object.values(healthData).reduce((sum: number, d: any) => sum + d.impressions, 0);

// Per-period GSC aggregates for the Fleet Quick View toggle, summed from TRUE
// per-calendar-day rows (gsc_daily.json, dimension=date). day = last day,
// week = last 7 days, month = last 28 days. Position = impression-weighted avg.
// (Do NOT use gsc_history.json here — that snapshots the rolling 28d total per day.)
const gscDaily = loadJson('gsc_daily.json') || {};
function windowAgg(siteId: string, days: number) {
  const arr = ((gscDaily as any)[siteId]?.days || []) as any[];
  let clicks = 0, impressions = 0, posW = 0;
  for (const d of arr.slice(-days)) {
    clicks += d.clicks || 0;
    impressions += d.impressions || 0;
    posW += (d.position || 0) * (d.impressions || 0);
  }
  return { clicks, impressions, position: impressions ? +(posW / impressions).toFixed(1) : null };
}
const periodData: Record<string, any> = {};
for (const c of clients) {
  periodData[c.id] = {
    day: windowAgg(c.id, 1),
    week: windowAgg(c.id, 7),
    month: windowAgg(c.id, 28),
  };
}

// Fleet clicks trend — sum per-day clicks across all dashboard sites (last 28
// calendar days) so the home page shows the click STREAM over time, not just a
// frozen 28d total. Built from gsc_daily.json (dimension=date), already loaded.
function fleetClicksSeries(days: number): number[] {
  const byDate: Record<string, number> = {};
  for (const c of clients) {
    const arr = ((gscDaily as any)[c.id]?.days || []) as any[];
    for (const d of arr.slice(-days)) {
      byDate[d.date] = (byDate[d.date] || 0) + (d.clicks || 0);
    }
  }
  return Object.keys(byDate).sort().map((k) => byDate[k]);
}
const clicksSeries = fleetClicksSeries(28);
const clicksSeriesMax = Math.max(1, ...clicksSeries);
const clicksLast7 = clicksSeries.slice(-7).reduce((s, n) => s + n, 0);
const clicksPrev7 = clicksSeries.slice(-14, -7).reduce((s, n) => s + n, 0);
const clicksWoW = clicksPrev7 ? Math.round(((clicksLast7 - clicksPrev7) / clicksPrev7) * 100) : null;

// Three search funnels at the top — Google clicks (GSC 28-30d) · Bing clicks (BWT 5-7d) · AI visits (GA4 30d)
// Bing clicks sum the per-day traffic_stats rows (the real signal) instead of top_queries (which is capped at 25 + per-day).
function bingClicksFor(siteId: string): number {
  const ts = ((bing as any)[siteId]?.traffic_stats || []) as any[];
  return ts.reduce((sum, d) => sum + (d.Clicks || 0), 0);
}
function aiVisitsFor(siteId: string): number {
  const srcs = (((ga4 as any)[siteId]?.ai_assistant?.sources_30d) || []) as any[];
  return srcs.filter((s) => !s?.error).reduce((sum, s) => sum + (s.sessions || 0), 0);
}
const fleetSiteIds = [...clientIds];
const totalBingClicks = fleetSiteIds.reduce((sum, sid) => sum + bingClicksFor(sid), 0);
const totalAiVisits = fleetSiteIds.reduce((sum, sid) => sum + aiVisitsFor(sid), 0);

// YouTubeTile is fleet-only (covers PC, MHQ, Kartapay channels). Rank
// dashboard (R4 + RB) isn't in YT tracking scope yet, so gate the render.
// Mirrors the isFleet pattern in src/layouts/DashboardLayout.astro:27.
const isFleet = (process.env.DASHBOARD || 'current').toLowerCase() === 'fleet';

// Site type / monetisation pill. `monetisation` (clients.json) is the money model;
// banner = display-ad cluster, leadgen = form funnels, editorial = content/SEO,
// saas / client = the outliers. Falls back to `flavour` when monetisation absent.
const TYPE_META: Record<string, { label: string; pill: string }> = {
  'banner':            { label: 'Banner',        pill: 'bg-fuchsia-900/40 text-fuchsia-300' },
  'banner+affiliate':  { label: 'Banner+Aff',    pill: 'bg-fuchsia-900/40 text-fuchsia-300' },
  'affiliate':         { label: 'Affiliate',     pill: 'bg-pink-900/40 text-pink-300' },
  'leadgen':           { label: 'Lead-gen',      pill: 'bg-cyan-900/40 text-cyan-300' },
  'editorial':         { label: 'Editorial',     pill: 'bg-indigo-900/40 text-indigo-300' },
  'saas':              { label: 'SaaS',          pill: 'bg-teal-900/40 text-teal-300' },
  'client':            { label: 'Client',        pill: 'bg-gray-700 text-gray-300' },
};
function typeOf(c: any) {
  const key = (c?.monetisation || c?.flavour || '').toLowerCase();
  return TYPE_META[key] || (key ? { label: key, pill: 'bg-gray-700 text-gray-300' } : null);
}
---

<DashboardLayout title="Dashboard">
  {/* FLEET PARITY NOTE — standing reminder to bring every site up to the completeness checklist */}
  <section data-copy-tile="Fleet parity check" class="mb-6 rounded-lg border border-amber-700/50 bg-amber-950/30 px-4 py-3">
    <div class="text-[10px] uppercase tracking-wider text-amber-300 font-semibold">Fleet parity check &middot; do this at some point</div>
    <p class="text-sm text-amber-100/90 mt-1 leading-relaxed">
      Bring <strong>every site into unity</strong> with the page-type &amp; asset completeness checklist
      (<code class="text-amber-200">FLEET/SITE_PAGE_TYPE_COMPLETENESS.md</code>): <code>/statistics/</code>, <code>/compare/</code> + real tables,
      <code>/guides/</code>, <code>/sectors/</code>, <code>/tools/</code>, <code>/authors/</code>, <code>/accreditations/</code>,
      llms-full.txt, ai.txt, agent-data layer, no FAQPage.
    </p>
    <p class="text-[11px] text-amber-200/70 mt-1">
      Reference builds (complete): Company Rescue, Invoice Finance. Known-thin (need bringing up): equity-release, womens-health, homesandhedge, steve-site.
    </p>
  </section>

  {/* SEARCH FUNNELS — the click streams that bring real visitors, headlined */}
  <section data-copy-tile="Search funnels" class="mb-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">
    <div class="rounded-lg border border-emerald-800/50 bg-emerald-950/30 px-4 py-3">
      <div class="flex items-center justify-between">
        <span class="text-[10px] uppercase tracking-wider text-emerald-300 font-semibold">Google clicks</span>
        <span class="text-[9px] text-gray-500">GSC · 28–30d</span>
      </div>
      <div class="text-3xl font-bold text-white mt-1">{totalClicks.toLocaleString()}</div>
      <div class="text-[10px] text-gray-500 mt-1">Clicks from a google.com search-result page. Doesn't include Bing or AI tools.</div>
    </div>
    <div class="rounded-lg border border-amber-800/50 bg-amber-950/30 px-4 py-3">
      <div class="flex items-center justify-between">
        <span class="text-[10px] uppercase tracking-wider text-amber-300 font-semibold">Google impressions</span>
        <span class="text-[9px] text-gray-500">GSC · 28–30d</span>
      </div>
      <div class="text-3xl font-bold text-white mt-1">{totalImpressions.toLocaleString()}</div>
      <div class="text-[10px] text-gray-500 mt-1">Times the fleet appeared on a google.com results page — total search visibility, before any click.</div>
    </div>
    <div class="rounded-lg border border-blue-800/50 bg-blue-950/30 px-4 py-3">
      <div class="flex items-center justify-between">
        <span class="text-[10px] uppercase tracking-wider text-blue-300 font-semibold">Bing clicks</span>
        <span class="text-[9px] text-gray-500">Bing WMT · 5–7d</span>
      </div>
      <div class="text-3xl font-bold text-white mt-1">{totalBingClicks.toLocaleString()}</div>
      <div class="text-[10px] text-gray-500 mt-1">Clicks from a bing.com search-result page (also feeds Copilot). Shorter window — API caps at ~7 days.</div>
    </div>
    <div class="rounded-lg border border-violet-800/50 bg-violet-950/30 px-4 py-3">
      <div class="flex items-center justify-between">
        <span class="text-[10px] uppercase tracking-wider text-violet-300 font-semibold">AI visits</span>
        <span class="text-[9px] text-gray-500">GA4 · 30d</span>
      </div>
      <div class="text-3xl font-bold text-white mt-1">{totalAiVisits.toLocaleString()}</div>
      <div class="text-[10px] text-gray-500 mt-1">Real GA4 sessions referred by ChatGPT / Perplexity / Gemini / Claude / Copilot. User clicked the link and the page loaded.</div>
    </div>
  </section>

  {/* FLEET QUICK VIEW — one row per site, all key signals at a glance, click site name to expand details */}
  <section class="mb-6">
    <div class="flex items-baseline justify-between mb-3 flex-wrap gap-2">
      <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider">Fleet quick view</h2>
      <div class="flex items-center gap-2">
        <div id="fqv-period-toggle" class="inline-flex rounded-md border border-gray-700 overflow-hidden text-[11px]">
          <button type="button" data-period="day" class="fqv-period px-2.5 py-1 text-gray-400 hover:text-white">Day</button>
          <button type="button" data-period="week" class="fqv-period px-2.5 py-1 text-gray-400 hover:text-white border-l border-gray-700">Week</button>
          <button type="button" data-period="month" class="fqv-period px-2.5 py-1 bg-indigo-600 text-white border-l border-gray-700">Month</button>
        </div>
        <span class="text-[10px] text-gray-500">Period changes Google clk/Impr/Pos only · click any header to sort ▲▼ · click ▸ for detail</span>
      </div>
    </div>
    <div class="overflow-x-auto rounded-lg border border-gray-800 bg-gray-900">
      <table class="w-full text-xs">
        <thead>
          <tr class="text-gray-400 border-b border-gray-800 bg-gray-950/50">
            <th class="text-left py-2 px-3"></th>
            <th class="text-left py-2 px-3">Site</th>
            <th class="text-right py-2 px-3" title="GA4 sessions — total visits from ALL sources (search, direct, AI, social), last 30 days">Users</th>
            <th class="text-right py-2 px-3" title="GA4 sessions — total visits from ALL sources (search, direct, AI, social), last 30 days">Sessions</th>
            <th class="text-right py-2 px-3" title="Google clicks — clicks from a google.com search-result page (GSC, last 28-30 days)">Google clk</th>
            <th class="text-right py-2 px-3" title="Bing clicks — clicks from a bing.com search-result page (Bing Webmaster Tools, last 5-7 days)">Bing clk</th>
            <th class="text-right py-2 px-3" title="AI visits — GA4 sessions referred by ChatGPT / Perplexity / Gemini / Claude / Copilot, last 30 days">AI visits</th>
            <th class="text-right py-2 px-3" title="GSC impressions — times the site appeared in Google search results">Impr</th>
            <th class="text-right py-2 px-3" title="Average Google ranking position for clicked queries">Pos</th>
            <th class="text-right py-2 px-3" title="AI citation rate — how often the brand is cited when we probe Claude / ChatGPT / Gemini / Perplexity (NOT traffic)">Cited %</th>
            <th class="text-right py-2 px-3" title="Hits from AI crawler bots (GPTBot, ClaudeBot, etc.)">AI Bots</th>
            <th class="text-right py-2 px-3">AIO</th>
            <th class="text-right py-2 px-3">Pages</th>
            <th class="text-right py-2 px-3">Issues</th>
            <th class="text-right py-2 px-3">Up%</th>
            <th class="text-right py-2 px-3">Crit/High</th>
          </tr>
        </thead>
        <tbody id="fqv-tbody">
          {(clients as any[])
            .filter((c) => clientIds.has(c.id))
            // Live sites only — drop pre-launch / paused builds (BuilderWeb, Nordic, legal-leadgen)
            .filter((c) => c.siteStatus === 'live' || (c.dashboard === 'current' && c.pre_launch !== true && c.siteStatus !== 'paused' && c.siteStatus !== 'needs'))
            // Top performers first — by Google impressions (month). Re-sorts client-side on period toggle.
            .sort((a, b) => (periodData[b.id]?.month?.impressions ?? 0) - (periodData[a.id]?.month?.impressions ?? 0))
            .map((clientMeta: any) => {
            const siteId = clientMeta.id;
            const displayName = clientMeta.name || siteId;
            const ga = (ga4 as any)[siteId] || {};
            const ov = ga.overview || {};
            const aiSrc = ((ga.ai_assistant || {}).sources_30d || []).filter((s: any) => !s?.error);
            const aiVisits = aiSrc.reduce((sum: number, s: any) => sum + (s.sessions || 0), 0);
            const bingTraffic = ((bing as any)[siteId]?.traffic_stats || []) as any[];
            const bingClicks = bingTraffic.reduce((sum: number, d: any) => sum + (d.Clicks || 0), 0);
            const g = (gsc as any)[siteId] || {};
            const totals = g.totals || {};
            const cit = (citations as any)[siteId]?.summary || {};
            const aiRate = Math.max(
              cit.claude?.rate ?? 0,
              cit.chatgpt?.rate ?? 0,
              cit.gemini?.rate ?? 0,
              cit.perplexity?.rate ?? 0,
            );
            const bh = (botHits as any)[siteId]?.by_type || {};
            const aiBots = bh.ai || 0;
            const aios = (aioSerp as any)[siteId] || {};
            const aioCount = aios.ai_overviews_detected || 0;
            const up = (uptime as any)[siteId] || {};
            const upPct = up.uptime_pct;
            const r = (recs as any)[siteId] || {};
            const ch = (r.critical || 0) + (r.high || 0);
            const crawl = loadJson(`crawl_${siteId}.json`) || {};
            const pages = crawl.pages_crawled || 0;
            const issues = crawl.total_issues || 0;
            const schemaPct = pages ? Math.round((crawl.pages_with_schema || 0) / pages * 100) : 0;
            const topRecs = (r.recommendations || []).filter((rec: any) => rec.priority === 'critical' || rec.priority === 'high').slice(0, 5);
            const topQueries = (g.top_queries || []).slice(0, 5);
            const topPages = (g.top_pages || []).slice(0, 5);
            const pd = (periodData as any)[siteId] || { day: {}, week: {}, month: {} };
            return (
              <>
                <tr
                  class="border-b border-gray-800/50 hover:bg-gray-800/30 transition group cursor-pointer"
                  data-site={siteId}
                  data-cday={pd.day.clicks ?? 0} data-cweek={pd.week.clicks ?? 0} data-cmonth={pd.month.clicks ?? 0}
                  data-iday={pd.day.impressions ?? 0} data-iweek={pd.week.impressions ?? 0} data-imonth={pd.month.impressions ?? 0}
                  data-pday={pd.day.position ?? ''} data-pweek={pd.week.position ?? ''} data-pmonth={pd.month.position ?? ''}
                  onclick={`document.getElementById('fqv-${siteId}').classList.toggle('hidden')`}>
                  <td class="py-2 px-3 text-gray-500">▸</td>
                  <td class="py-2 px-3"><a href={`/agency/${siteId}`} class="font-semibold text-indigo-400 hover:text-indigo-300">{displayName}</a></td>
                  <td class="py-2 px-3 text-right text-white">{(ov.active_users ?? 0).toLocaleString()}</td>
                  <td class="py-2 px-3 text-right text-white">{(ov.sessions ?? 0).toLocaleString()}</td>
                  <td data-col="clicks" class="py-2 px-3 text-right text-emerald-400 font-semibold">{(totals.clicks ?? 0).toLocaleString()}</td>
                  <td class={`py-2 px-3 text-right font-semibold ${bingClicks > 0 ? 'text-blue-400' : 'text-gray-500'}`}>{bingClicks.toLocaleString()}</td>
                  <td class={`py-2 px-3 text-right font-semibold ${aiVisits > 0 ? 'text-violet-400' : 'text-gray-500'}`}>{aiVisits.toLocaleString()}</td>
                  <td data-col="impr" class="py-2 px-3 text-right text-white">{(totals.impressions ?? 0).toLocaleString()}</td>
                  <td data-col="pos" class="py-2 px-3 text-right text-gray-400">{totals.position?.toFixed(1) ?? '—'}</td>
                  <td class={`py-2 px-3 text-right ${aiRate > 0 ? 'text-emerald-400' : 'text-gray-500'}`}>{aiRate ? `${aiRate}%` : '0%'}</td>
                  <td class="py-2 px-3 text-right text-amber-400">{aiBots.toLocaleString()}</td>
                  <td class={`py-2 px-3 text-right ${aioCount > 0 ? 'text-purple-400' : 'text-gray-500'}`}>{aioCount}</td>
                  <td class="py-2 px-3 text-right text-gray-300">{pages.toLocaleString()}</td>
                  <td class={`py-2 px-3 text-right ${issues > 30 ? 'text-red-400' : issues > 10 ? 'text-amber-400' : 'text-emerald-400'}`}>{issues}</td>
                  <td class={`py-2 px-3 text-right ${upPct >= 99 ? 'text-emerald-400' : upPct >= 95 ? 'text-amber-400' : 'text-gray-500'}`}>{upPct ? `${upPct}%` : '—'}</td>
                  <td class={`py-2 px-3 text-right font-semibold ${ch > 3 ? 'text-red-400' : ch > 0 ? 'text-amber-400' : 'text-emerald-400'}`}>{ch}</td>
                </tr>
                <tr id={`fqv-${siteId}`} data-detail={siteId} class="hidden">
                  <td colspan="16" class="bg-gray-950/70 px-6 py-4 border-b border-gray-800">
                    <div class="grid md:grid-cols-3 gap-6">
                      <div>
                        <h4 class="text-[11px] uppercase tracking-wider text-gray-500 mb-2 font-semibold">SEO health</h4>
                        <ul class="space-y-1 text-[12px] text-gray-300">
                          <li>Pages crawled: <span class="text-white">{pages.toLocaleString()}</span></li>
                          <li>With schema: <span class="text-white">{crawl.pages_with_schema || 0} ({schemaPct}%)</span></li>
                          <li>2000+ words: <span class="text-white">{crawl.pages_over_2000_words || 0}</span></li>
                          <li>Comparison tables: <span class="text-white">{crawl.pages_with_comparison_table || 0}</span></li>
                          <li>Multi-modal: <span class="text-white">{crawl.pages_with_multimodal || 0}</span></li>
                          <li>Total issues: <span class={issues > 30 ? 'text-red-400' : issues > 10 ? 'text-amber-400' : 'text-emerald-400'}>{issues}</span></li>
                          <li>Orphan pages: <span class={(crawl.orphan_pages || 0) > 30 ? 'text-amber-400' : 'text-gray-300'}>{crawl.orphan_pages || 0}</span></li>
                          <li>Images missing alt: <span class="text-gray-300">{crawl.images_missing_alt || 0}</span></li>
                        </ul>
                      </div>
                      <div>
                        <h4 class="text-[11px] uppercase tracking-wider text-gray-500 mb-2 font-semibold">Top Crit/High recs ({ch})</h4>
                        {topRecs.length > 0 ? (
                          <ol class="space-y-1.5 text-[12px] text-gray-300 list-decimal list-inside">
                            {topRecs.map((rec: any) => (
                              <li>
                                <span class={`text-[10px] font-bold uppercase mr-1 ${rec.priority === 'critical' ? 'text-red-400' : 'text-amber-400'}`}>{rec.priority?.slice(0,4)}</span>
                                {rec.title}
                              </li>
                            ))}
                          </ol>
                        ) : (
                          <p class="text-[12px] text-emerald-400">No critical or high recs.</p>
                        )}
                        <a href={`/agency/${siteId}/recommendations`} class="text-[11px] text-indigo-400 hover:text-indigo-300 underline mt-2 inline-block">All recommendations →</a>
                      </div>
                      <div>
                        <h4 class="text-[11px] uppercase tracking-wider text-gray-500 mb-2 font-semibold">Top GSC queries / pages</h4>
                        {topQueries.length > 0 ? (
                          <ul class="space-y-1 text-[12px] text-gray-300">
                            {topQueries.map((q: any) => (
                              <li class="flex justify-between gap-2"><span class="truncate">{q.query}</span><span class="text-gray-500 shrink-0">{q.impressions} imp · pos {q.position?.toFixed?.(0)}</span></li>
                            ))}
                          </ul>
                        ) : (
                          <p class="text-[12px] text-gray-500">No GSC data yet.</p>
                        )}
                        {topPages.length > 0 && (
                          <a href={`/agency/${siteId}/search-performance`} class="text-[11px] text-indigo-400 hover:text-indigo-300 underline mt-2 inline-block">Search Performance →</a>
                        )}
                      </div>
                    </div>
                  </td>
                </tr>
              </>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  {/* The ranked, per-site action queue built from every finding feed — the layer
      that turns diagnosis into a to-do. Sits above the raw click tiles below. */}
  <PerSiteEnhancementsTile />

  {/* CLICKS — the full click story the per-site total alone hides: trend over time,
      page-level clicks, within-reach opportunities, and what's slipping. */}
  {clicksSeries.length > 1 && (
    <section data-copy-tile="Fleet clicks trend" class="mb-6 rounded-lg border border-emerald-800/50 bg-emerald-950/20 px-4 py-3">
      <div class="flex items-baseline justify-between flex-wrap gap-2">
        <span class="text-[10px] uppercase tracking-wider text-emerald-300 font-semibold">Fleet clicks trend · last 28 days</span>
        <span class="text-[11px] text-gray-400">
          {clicksLast7.toLocaleString()} clicks last 7d
          {clicksWoW !== null && (
            <span class={clicksWoW >= 0 ? 'text-emerald-300' : 'text-rose-300'}> · {clicksWoW >= 0 ? '+' : ''}{clicksWoW}% WoW</span>
          )}
        </span>
      </div>
      <div class="flex items-end gap-[2px] h-12 mt-2">
        {clicksSeries.map((n) => (
          <div
            class="flex-1 bg-emerald-500/70 rounded-t-sm min-h-[1px]"
            style={`height:${Math.max(2, Math.round((n / clicksSeriesMax) * 100))}%`}
            title={`${n} clicks`}
          ></div>
        ))}
      </div>
      <div class="text-[10px] text-gray-500 mt-1">Per-day Google clicks summed across the fleet (GSC, dimension=date). The stream over time — not the frozen 28-day total.</div>
    </section>
  )}

  <ClicksWithinReachTile />
  <LosingClicksTile />
  <TopPagesByClicksTile siteIds={[...clientIds]} />

  {/* Fleet Feature Coverage — headline grid: which site has which high-end fleet feature */}
  {isFleet && (
    <div data-copy-tile="Fleet feature coverage" class="mb-6">
      <FeatureCoverageTile />
    </div>
  )}

  {/* AI Bot Intelligence — which AI crawlers fetch our pages and AI files */}
  {isFleet && (
    <div data-copy-tile="AI bot intelligence" class="mb-6">
      <FleetBotHitsTile />
    </div>
  )}

  {/* AI Visibility — AEO readiness vs actual citation rate per engine */}
  {isFleet && (
    <div data-copy-tile="AI visibility" class="mb-6">
      <AiVisibilityTile />
    </div>
  )}

  <!-- Header -->
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-xl font-bold text-white">Dashboard</h1>
      {freshBanner ? (
        <a href="/ops" class={`inline-flex items-center gap-2 mt-1 px-2.5 py-1 rounded text-xs font-medium ${
          freshBanner.tone === 'bad' ? 'bg-red-950 text-red-300 border border-red-800'
          : freshBanner.tone === 'warn' ? 'bg-amber-950 text-amber-300 border border-amber-800'
          : 'bg-emerald-950 text-emerald-300 border border-emerald-900'}`}>
          <span class={`h-1.5 w-1.5 rounded-full ${
            freshBanner.tone === 'bad' ? 'bg-red-400' : freshBanner.tone === 'warn' ? 'bg-amber-400' : 'bg-emerald-400'}`}></span>
          <span>Data as of {freshBanner.asOf} · {freshBanner.line}</span>
        </a>
      ) : (
        <p class="text-xs text-gray-500">Last refresh: {lastRefresh}</p>
      )}
      {freshBanner && freshBanner.stale.length > 0 && (
        <p class="text-[11px] text-gray-500 mt-1">Lagging: {freshBanner.stale.join(' · ')}</p>
      )}
    </div>
    <div class="flex gap-2">
      <button id="refresh-btn" class="px-3 py-1.5 bg-blue-600 text-white rounded text-sm hover:bg-blue-500 transition">
        Refresh All Data
      </button>
      <a href="/ops" class="px-3 py-1.5 bg-gray-800 text-gray-300 rounded text-sm hover:bg-gray-700 transition">
        Ops / Health
      </a>
      {clientIds.has('rank4ai') && (
        <a href="/crm" class="px-3 py-1.5 bg-gray-800 text-gray-300 rounded text-sm hover:bg-gray-700 transition">
          CRM Pipeline
        </a>
      )}
    </div>
  </div>

  {/* Leads pinned at the very top of Home — leads are the point of the fleet */}
  <LeadsSummaryTile />

  {/* Wins This Week — daily progress diff */}
  {wins && (
    <div data-copy-tile="Wins This Week" class={`rounded-lg px-4 py-3 mb-4 border ${wins.fleet_cleared_today > 0 || wins.fleet_cleared_7d > 0 ? 'bg-emerald-950/30 border-emerald-800/50' : 'bg-gray-900 border-gray-700'}`}>
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div class="flex items-center gap-3">
          <span class="text-xs font-semibold text-emerald-300 uppercase tracking-wider">Wins This Week</span>
          {wins.fleet_cleared_today > 0
            ? <span class="text-sm text-emerald-400 font-semibold">{wins.fleet_cleared_today} recs cleared today</span>
            : <span class="text-sm text-gray-400">0 cleared today</span>
          }
          <span class="text-gray-600">·</span>
          <span class="text-xs text-emerald-400">{wins.fleet_cleared_7d} in last 7 days</span>
          {wins.fleet_new_today > 0 && <>
            <span class="text-gray-600">·</span>
            <span class="text-xs text-red-400">{wins.fleet_new_today} new regressions</span>
          </>}
          <span class="text-gray-600">·</span>
          <span class="text-xs text-gray-500">{wins.fleet_stuck} stuck ≥7d (strategic)</span>
        </div>
        <details class="text-xs">
          <summary class="cursor-pointer text-emerald-400 hover:text-emerald-300">what changed</summary>
          <div class="absolute right-8 mt-2 bg-gray-800 border border-gray-700 rounded-lg p-3 shadow-xl z-50 min-w-[520px] max-h-[500px] overflow-y-auto">
            {Object.entries(wins.per_site || {}).filter(inDash).map(([site, d]: [string, any]) => (
              <div class="mb-3">
                <div class="text-xs font-semibold text-white mb-1">{site}</div>
                {d.cleared_today?.length > 0 && (
                  <div class="mb-1">
                    <div class="text-[10px] text-emerald-400 font-semibold">✓ Cleared today ({d.cleared_today.length})</div>
                    {d.cleared_today.map((t: string) => <div class="text-[11px] text-gray-300 pl-3">· {t}</div>)}
                  </div>
                )}
                {d.new_today?.length > 0 && (
                  <div class="mb-1">
                    <div class="text-[10px] text-red-400 font-semibold">⚠ New today ({d.new_today.length})</div>
                    {d.new_today.map((t: string) => <div class="text-[11px] text-gray-300 pl-3">· {t}</div>)}
                  </div>
                )}
                {d.counts.cleared_today === 0 && d.counts.new_today === 0 && (
                  <div class="text-[10px] text-gray-500 italic">no change today</div>
                )}
              </div>
            ))}
          </div>
        </details>
      </div>
    </div>
  )}

  {/* Manual GSC submissions tile removed 28 May 2026 — Indexing API + IndexNow now do this automatically; daily-paste workflow obsolete */}

  {/* AI Traffic — live referrals from ChatGPT / Perplexity / Gemini / Claude / Copilot */}
  {ga4 && (() => {
    const rows = Object.entries(ga4)
      .filter(([sid]) => clientIds.has(sid))
      .map(([sid, d]: [string, any]) => {
        const ai = d?.ai_assistant || {};
        const sources = (ai.sources_30d || []).filter((s: any) => !s?.error);
        const aiSessions30d = sources.reduce((a: number, s: any) => a + (s.sessions || 0), 0);
        const totalSessions30d = d?.overview?.sessions || 0;
        const pct = totalSessions30d > 0 ? Math.round((aiSessions30d / totalSessions30d) * 1000) / 10 : 0;
        const topSource = sources[0]?.source || '—';
        return {
          sid,
          name: ((clients as any[]).find((c: any) => c.id === sid)?.name) || sid,
          totalSessions30d,
          aiSessions30d,
          aiPct: pct,
          topSource,
          topSourceSessions: sources[0]?.sessions || 0,
          sources,
          topLanding: (ai.top_landing_pages_30d || []).filter((p: any) => !p?.error),
          aiAssistant7d: ai.last_7d?.sessions || 0,
          aiAssistant7dDelta: ai.delta_pct,
        };
      })
      .filter((r) => r.totalSessions30d > 0 || r.aiSessions30d > 0)
      .sort((a, b) => b.aiSessions30d - a.aiSessions30d);
    if (rows.length === 0) return null;
    const fleetAi = rows.reduce((a, r) => a + r.aiSessions30d, 0);
    const fleetTotal = rows.reduce((a, r) => a + r.totalSessions30d, 0);
    const fleetPct = fleetTotal > 0 ? Math.round((fleetAi / fleetTotal) * 1000) / 10 : 0;
    return (
      <div data-copy-tile="AI Traffic" class="rounded-lg px-4 py-3 mb-4 border bg-violet-950/30 border-violet-800/50">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-3">
          <div class="flex items-center gap-3">
            <span class="text-xs font-semibold text-violet-300 uppercase tracking-wider">AI Traffic (30d)</span>
            <span class="text-sm text-violet-400 font-semibold">{fleetAi} sessions from AI assistants</span>
            <span class="text-[10px] text-gray-500">{fleetPct}% of {fleetTotal} fleet sessions</span>
          </div>
          <span class="text-[10px] text-gray-500">Source: GA4 sessionSource matching ChatGPT/Perplexity/Gemini/Claude/Copilot/You/Phind</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-xs">
            <thead>
              <tr class="text-left text-gray-500 border-b border-gray-800">
                <th class="py-1.5 pr-3">Site</th>
                <th class="py-1.5 pr-3 text-right">30d sessions</th>
                <th class="py-1.5 pr-3 text-right">AI 30d</th>
                <th class="py-1.5 pr-3 text-right">AI %</th>
                <th class="py-1.5 pr-3">Top AI source</th>
                <th class="py-1.5 pr-3 text-right">AI 7d</th>
                <th class="py-1.5">Δ vs prior</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr class="border-b border-gray-800/50">
                  <td class="py-1.5 pr-3 text-white">{r.name}</td>
                  <td class="py-1.5 pr-3 text-right text-gray-400">{r.totalSessions30d}</td>
                  <td class="py-1.5 pr-3 text-right text-violet-400 font-semibold">{r.aiSessions30d}</td>
                  <td class="py-1.5 pr-3 text-right text-gray-300">{r.aiPct}%</td>
                  <td class="py-1.5 pr-3 text-gray-300">{r.topSource} {r.topSourceSessions > 0 && <span class="text-gray-600">({r.topSourceSessions})</span>}</td>
                  <td class="py-1.5 pr-3 text-right text-gray-300">{r.aiAssistant7d}</td>
                  <td class="py-1.5 text-gray-400">
                    {r.aiAssistant7dDelta === null || r.aiAssistant7dDelta === undefined
                      ? <span class="text-gray-600">—</span>
                      : r.aiAssistant7dDelta >= 0
                        ? <span class="text-emerald-400">+{r.aiAssistant7dDelta}%</span>
                        : <span class="text-rose-400">{r.aiAssistant7dDelta}%</span>
                    }
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {rows.some((r) => r.topLanding.length > 0) && (
          <div class="mt-4 pt-3 border-t border-gray-800">
            <div class="text-[10px] font-semibold text-violet-300 uppercase tracking-wider mb-2">Pages AI is citing (30d landing pages from AI sources)</div>
            <div class="flex flex-wrap gap-3">
              {rows.filter((r) => r.topLanding.length > 0).map((r) => (
                <div class="min-w-[220px] flex-1 rounded border border-violet-900/40 bg-violet-950/20 px-3 py-2">
                  <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-semibold text-white">{r.name}</span>
                    <span class="text-[10px] text-violet-400">{r.sources.map((s: any) => `${s.source.replace(/\.(com|ai|google\.com|microsoft\.com)$/, '')} ${s.sessions}`).join(' · ')}</span>
                  </div>
                  <ul class="space-y-0.5">
                    {r.topLanding.slice(0, 6).filter((p: any) => p.path && p.path !== '(not set)').map((p: any) => (
                      <li class="flex items-center justify-between gap-2 text-[11px]">
                        <span class="text-gray-300 truncate">{p.path === '/' ? '/ (home)' : p.path}</span>
                        <span class="text-violet-400 shrink-0">{p.sessions}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        )}
        <p class="text-[10px] text-gray-500 mt-3 pt-2 border-t border-gray-800">
          GA4 wired across all fleet properties. AI 30d (via sessionSource matching the AI hosts) is the leading number and is independent of GA4 config. A native "AI Assistants" channel group is being added per-property in GA4 Admin, which will also populate AI 7d + delta. "Pages AI is citing" shows the landing pages that AI-referred sessions hit, the clearest signal of which content is being cited.
        </p>
      </div>
    );
  })()}

  {/* Content freshness — days-since-update + refresh pile (Batch 6, daily) */}
  {contentFreshness && contentFreshness.fleet_summary && (
    <div data-copy-tile="Content Freshness" class="rounded-lg px-4 py-2 mb-4 border bg-gray-900 border-gray-700">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div class="flex items-center gap-3">
          <span class="text-xs font-semibold text-cyan-300 uppercase tracking-wider">Content freshness</span>
          <span class="text-sm text-gray-300">
            {contentFreshness.fleet_summary.with_dates}/{contentFreshness.fleet_summary.total_pages} pages dated
          </span>
          <span class="text-xs text-gray-500">·</span>
          <span class="text-xs text-emerald-400">{contentFreshness.fleet_summary.fresh_30d} fresh ≤30d</span>
          {contentFreshness.fleet_summary.stale_12mo > 0 && (
            <span class="text-xs text-amber-400 font-semibold">⚠ {contentFreshness.fleet_summary.stale_12mo} stale &gt;12mo</span>
          )}
        </div>
        <details class="text-xs">
          <summary class="cursor-pointer text-cyan-400 hover:text-cyan-300">refresh pile</summary>
          <div class="absolute right-8 mt-2 bg-gray-800 border border-gray-700 rounded-lg p-3 shadow-xl z-50 min-w-[560px] max-h-[460px] overflow-y-auto">
            {Object.entries(contentFreshness).filter(([k]) => k !== 'fleet_summary').filter(inDash).map(([sid, d]: [string, any]) => (
              <div class="mb-3 last:mb-0 pb-2 border-b border-gray-700 last:border-0">
                <div class="text-xs font-semibold text-white mb-1">
                  {sid} <span class="text-[10px] text-gray-500 ml-2">median age {d.median_age_days ?? '—'}d</span>
                </div>
                {d.refresh_pile?.length > 0 ? d.refresh_pile.slice(0, 5).map((p: any) => (
                  <div class="text-[11px] mb-1">
                    <span class="text-cyan-400">{p.age_days}d</span>
                    <a href={p.url} target="_blank" class="text-gray-300 ml-2 hover:text-white">{p.h1 || p.path}</a>
                  </div>
                )) : (
                  <div class="text-[10px] text-gray-500 pl-2">No dated pages</div>
                )}
              </div>
            ))}
            <div class="text-[10px] text-gray-500 mt-2 pt-2 border-t border-gray-700">Refresh pile = oldest dated pages excluding privacy/terms/cookies/admin. Source: per-site page-dates.json (git-derived).</div>
          </div>
        </details>
      </div>
    </div>
  )}

  {/* Syndication tracker — hidden until at least one post is tracked */}
  {syndication && syndication.fleet_summary && (syndication.fleet_summary.post_count || 0) > 0 && (
    <div data-copy-tile="Syndication tracker" class="rounded-lg px-4 py-2 mb-4 border bg-gray-900 border-gray-700">
      <div class="flex items-center justify-between flex-wrap gap-3">
        <div class="flex items-center gap-3">
          <span class="text-xs font-semibold text-purple-300 uppercase tracking-wider">Syndication</span>
          {syndication.fleet_summary.post_count > 0 ? (
            <>
              <span class="text-sm text-gray-300">{syndication.fleet_summary.post_count} posts tracked</span>
              <span class="text-xs text-emerald-400">{syndication.fleet_summary.fully_distributed} on all 8 platforms</span>
              {syndication.fleet_summary.under_distributed > 0 && (
                <span class="text-xs text-amber-400">{syndication.fleet_summary.under_distributed} under-distributed</span>
              )}
            </>
          ) : (
            <span class="text-sm text-gray-500">No syndication tracked yet — populate src/data/syndication_log.json to light this up</span>
          )}
          <span class="text-[10px] text-gray-500">{(syndication.fleet_summary.platforms_tracked || []).join(', ')}</span>
        </div>
        {syndication.fleet_summary.post_count > 0 && (
          <details class="text-xs">
            <summary class="cursor-pointer text-purple-400 hover:text-purple-300">under-distributed</summary>
            <div class="absolute right-8 mt-2 bg-gray-800 border border-gray-700 rounded-lg p-3 shadow-xl z-50 min-w-[520px] max-h-[420px] overflow-y-auto">
              {Object.entries(syndication).filter(([k]) => k !== 'fleet_summary').filter(inDash).map(([sid, d]: [string, any]) => (
                <div class="mb-3 last:mb-0 pb-2 border-b border-gray-700 last:border-0">
                  <div class="text-xs font-semibold text-white mb-1">{sid} <span class="text-[10px] text-gray-500 ml-2">median {d.median_distribution}%</span></div>
                  {(d.under_distributed || []).slice(0, 5).map((p: any) => (
                    <div class="text-[11px] mb-1">
                      <span class="text-purple-400">{p.score}%</span>
                      <a href={p.url} target="_blank" class="text-gray-300 ml-2 hover:text-white">{p.title}</a>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </details>
        )}
      </div>
    </div>
  )}

  {/* Cloudflare AI Crawl Control — true-count bot traffic from the edge */}
  {cfCrawls && (
    <div data-copy-tile="Cloudflare AI Crawl Control" class="rounded-lg px-4 py-3 mb-4 border bg-orange-950/30 border-orange-900/50">
      <div class="flex items-center justify-between flex-wrap gap-3 mb-2">
        <div class="flex items-center gap-3">
          <span class="text-xs font-semibold text-orange-300 uppercase tracking-wider">Cloudflare AI Crawl Control (14d)</span>
          <span class="text-[11px] text-gray-400">Edge-level bot counts, true hits</span>
        </div>
        <span class="text-[10px] text-gray-500">Fetched {cfCrawls.fetched_at ? new Date(cfCrawls.fetched_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : '—'}</span>
