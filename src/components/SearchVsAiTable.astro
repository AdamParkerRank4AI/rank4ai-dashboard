---
/**
 * SearchVsAiTable — "Search vs AI Search" metric comparison table.
 *
 * Styled to match the dashboard's own dark cards/tables (bg-gray-900 card,
 * slate dividers, tabular-nums), NOT a white standalone table. Data is passed
 * in via `rows` so it can be reused per site.
 */
interface Row {
  metric: string;
  search: string;
  ai: string;
}
interface Props {
  title?: string;
  rows: Row[];
}
const { title = 'Search vs AI Search', rows } = Astro.props as Props;
---

<div class="bg-gray-900 border border-gray-700 rounded-lg p-5">
  <div class="flex items-center justify-between mb-3">
    <h3 class="text-sm font-semibold text-white">{title}</h3>
    <span class="text-[10px] text-gray-500">organic search vs AI / LLM surfaces</span>
  </div>
  <table class="w-full text-sm">
    <thead class="text-slate-500">
      <tr class="text-left">
        <th class="py-2 font-medium">Metric</th>
        <th class="py-2 text-right font-medium text-blue-400">Search</th>
        <th class="py-2 text-right font-medium text-fuchsia-400">AI Search</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr class="border-t border-slate-800">
          <td class="py-3 text-gray-300">{r.metric}</td>
          <td class="py-3 text-right tabular-nums text-white">{r.search}</td>
          <td class="py-3 text-right tabular-nums text-white">{r.ai}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
