---
/**
 * YouTubeTile — fleet YouTube analytics with AI-referrer breakdown.
 *
 * Headline metric is the AI-referrer split (Perplexity / ChatGPT / Gemini /
 * Claude / other). That's the signal nobody else in the fleet stack measures.
 *
 * Reads src/data/live/youtube.json (written by scripts/fetch_youtube.py).
 * Renders defensively against status='auth_pending' | 'channel_id_pending' |
 * 'error' so a half-wired fleet doesn't break the dashboard.
 */
import fs from 'node:fs';
import path from 'node:path';

function loadJson(filename: string) {
  try {
    const filePath = path.join(process.cwd(), 'src', 'data', 'live', filename);
    if (fs.existsSync(filePath)) {
      return JSON.parse(fs.readFileSync(filePath, 'utf-8'));
    }
  } catch {}
  return null;
}

const data = loadJson('youtube.json') || { fetched_at: null, channels: {} };
const channels = data.channels || {};
const fetchedAt = data.fetched_at
  ? new Date(data.fetched_at).toLocaleString('en-GB', {
      timeZone: 'Europe/London',
      day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit',
    })
  : '--';

// Channel display order — matches Bing tile sort, AI-ready channels first.
const CHANNEL_ORDER = ['peptideclear', 'merchanthq', 'kartapay'];
const orderedKeys = [
  ...CHANNEL_ORDER.filter((k) => k in channels),
  ...Object.keys(channels).filter((k) => !CHANNEL_ORDER.includes(k)),
];

// AI referrer rows — fixed order, surface even when zero so the panel
// stays shaped regardless of data state.
const AI_ROWS: { key: string; label: string }[] = [
  { key: 'perplexity.ai',       label: 'Perplexity' },
  { key: 'chatgpt.com',         label: 'ChatGPT' },   // chat.openai.com folded in below
  { key: 'gemini.google.com',   label: 'Gemini' },
  { key: 'claude.ai',           label: 'Claude' },
  { key: 'other',               label: 'Other referrers' },
];

function aiRowValue(refs: Record<string, number> | undefined, key: string): number {
  if (!refs) return 0;
  if (key === 'chatgpt.com') {
    // Fold both ChatGPT host variants into one displayed row.
    return (refs['chatgpt.com'] || 0) + (refs['chat.openai.com'] || 0);
  }
  return refs[key] || 0;
}
---

<div class="rounded-lg border border-gray-700 bg-gray-800/60 p-5" data-tile="youtube">
  <div class="flex items-start justify-between mb-4">
    <div>
      <h3 class="text-white font-semibold text-sm flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-red-500"></span>
        YouTube · AI citations
      </h3>
      <p class="text-xs text-gray-400 mt-0.5">
        Referrer traffic from Perplexity / ChatGPT / Gemini / Claude to fleet videos (28d)
      </p>
    </div>
    <span class="text-[10px] text-gray-500">Last fetched: {fetchedAt}</span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    {orderedKeys.map((key) => {
      const c = channels[key] || {};
      const status = c.status || 'unknown';
      const isOk = status === 'ok';
      const isAuthPending = status === 'auth_pending';
      const isIdPending = status === 'channel_id_pending';
      const isError = status === 'error';

      // Greyed-out states share the same skeleton structure.
      if (!isOk) {
        const headline = isAuthPending
          ? 'Auth pending'
          : isIdPending
            ? 'Channel ID to be added'
            : `Error: ${c.reason || 'unknown'}`;
        const body = isAuthPending
          ? 'Re-grant analytics scope (youtube.readonly + yt-analytics.readonly).'
          : isIdPending
            ? 'Channel not yet created or channel_id not yet wired into fetch_youtube.py.'
            : (c.reason || '');
        return (
          <div class="rounded-md border border-gray-700/60 bg-gray-900/40 p-4 opacity-70">
            <div class="flex items-center justify-between mb-2">
              <div class="text-sm font-semibold text-gray-300">{c.site || key}</div>
              <span class="text-[9px] uppercase tracking-wider text-gray-500 border border-gray-700 rounded px-1.5 py-0.5">
                {status.replace('_', ' ')}
              </span>
            </div>
            <p class="text-xs text-gray-400 font-medium">{headline}</p>
            <p class="text-[11px] text-gray-500 mt-1 leading-snug">{body}</p>
          </div>
        );
      }

      const refs = c.ai_referrers_28d || {};
      const aiTotal = AI_ROWS
        .filter((r) => r.key !== 'other')
        .reduce((sum, r) => sum + aiRowValue(refs, r.key), 0);
      const topVideos = (c.top_videos_28d || []).slice(0, 5);
      const latest = (c.latest_videos || []).slice(0, 3);

      return (
        <div class="rounded-md border border-gray-700 bg-gray-900/60 p-4">
          <div class="flex items-center justify-between mb-3">
            <div>
              <div class="text-sm font-semibold text-white">{c.site || key}</div>
              <div class="text-[10px] text-gray-500">Channel {c.channel_id}</div>
            </div>
            <span class="text-[9px] uppercase tracking-wider text-emerald-300 bg-emerald-900/40 border border-emerald-800/60 rounded px-1.5 py-0.5">
              live
            </span>
          </div>

          {/* Top-line numbers */}
          <div class="grid grid-cols-3 gap-2 mb-3">
            <div class="bg-gray-800/60 rounded px-2 py-1.5">
              <div class="text-[9px] text-gray-400 uppercase tracking-wider">Subs</div>
              <div class="text-base font-bold text-white">{(c.subscribers ?? 0).toLocaleString()}</div>
            </div>
            <div class="bg-gray-800/60 rounded px-2 py-1.5">
              <div class="text-[9px] text-gray-400 uppercase tracking-wider">Total views</div>
              <div class="text-base font-bold text-white">{(c.total_views ?? 0).toLocaleString()}</div>
            </div>
            <div class="bg-gray-800/60 rounded px-2 py-1.5">
              <div class="text-[9px] text-gray-400 uppercase tracking-wider">Watch min · 28d</div>
              <div class="text-base font-bold text-white">{c.watch_minutes_28d ?? 0}</div>
            </div>
          </div>

          {/* AI referrer breakdown — headline metric */}
          <div class="bg-emerald-950/30 border border-emerald-900/50 rounded px-3 py-2 mb-3">
            <div class="flex items-center justify-between mb-2">
              <div class="text-[10px] uppercase tracking-wider font-medium text-emerald-300">
                AI referrers · 28d
              </div>
              <div class={`text-[10px] font-bold ${aiTotal > 0 ? 'text-emerald-300' : 'text-gray-500'}`}>
                {aiTotal} {aiTotal === 1 ? 'view' : 'views'}
              </div>
            </div>
            <div class="space-y-1">
              {AI_ROWS.map((row) => {
                const v = aiRowValue(refs, row.key);
                const isHot = v > 0 && row.key !== 'other';
                return (
                  <div class="flex items-center justify-between text-[11px]">
                    <span class={isHot ? 'text-emerald-300 font-medium' : 'text-gray-400'}>{row.label}</span>
                    <span class={isHot ? 'text-emerald-300 font-bold' : v > 0 ? 'text-gray-300' : 'text-gray-600'}>
                      {v}
                    </span>
                  </div>
                );
              })}
            </div>
          </div>

          {/* Top 5 videos by 28d views */}
          {topVideos.length > 0 && (
            <div class="mb-3">
              <div class="text-[10px] uppercase tracking-wider text-gray-400 font-medium mb-1">
                Top videos · 28d
              </div>
              <ul class="space-y-1">
                {topVideos.map((v: any) => (
                  <li class="flex items-center justify-between gap-2 text-[11px]">
                    <a
                      href={`https://youtu.be/${v.id}`}
                      target="_blank"
                      rel="noopener"
                      class="text-gray-300 hover:text-blue-400 truncate flex-1"
                      title={v.title || v.id}
                    >
                      {v.title || v.id}
                    </a>
                    <span class="text-gray-400 font-medium tabular-nums">{v.views}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* Latest uploads */}
          {latest.length > 0 && (
            <div>
              <div class="text-[10px] uppercase tracking-wider text-gray-400 font-medium mb-1">
                Latest uploads
              </div>
              <ul class="space-y-1">
                {latest.map((v: any) => (
                  <li class="flex items-center justify-between gap-2 text-[11px]">
                    <a
                      href={`https://youtu.be/${v.id}`}
                      target="_blank"
                      rel="noopener"
                      class="text-gray-300 hover:text-blue-400 truncate flex-1"
                      title={v.title || v.id}
                    >
                      {v.title || v.id}
                    </a>
                    <div class="flex items-center gap-2 flex-shrink-0">
                      <span class={`text-[9px] uppercase px-1 py-0.5 rounded ${
                        v.visibility === 'public'
                          ? 'bg-green-900/40 text-green-300'
                          : v.visibility === 'unlisted'
                            ? 'bg-yellow-900/30 text-yellow-300'
                            : 'bg-gray-800 text-gray-400'
                      }`}>{v.visibility}</span>
                      <span class="text-gray-500 tabular-nums">{v.uploaded}</span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      );
    })}
  </div>

  {orderedKeys.length === 0 && (
    <p class="text-xs text-gray-500 italic">No YouTube channels configured yet. Run scripts/fetch_youtube.py to seed data.</p>
  )}
</div>
