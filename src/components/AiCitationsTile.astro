---
/**
 * AiCitationsTile — "AI Citations (live)" headline tile.
 *
 * The real-time "we were just cited" signal: an ai-user fetch (ChatGPT-User /
 * Perplexity-User / Claude-User) means a human asked an AI a question and the AI
 * fetched OUR page live to answer it. Reads the `ai_citations` block of
 * src/data/live/fleet_bot_hits.json (written by scripts/fetch_fleet_bot_hits.py,
 * which verifies each hit against the operator's network so spoofed UAs don't
 * count). This is distinct from AiVisibilityTile (prompt-based "does engine X
 * recommend us") — this is server-log proof of live citation.
 *
 * Companion: ~/fleet-tools/ai-citation-watch.py Telegram-alerts on new hits.
 * Dark-card inline style like sibling tiles. Defensive against missing data.
 */
import fs from 'node:fs';
import path from 'node:path';
import clients from '../utils/dashboardClients';

// Map raw site ids (e.g. "cardmachines") to friendly client names ("MerchantHQ").
const nameOf = (id: string) => (clients as any[]).find((c) => c.id === id)?.name || id;
const idNameMap = JSON.stringify(Object.fromEntries((clients as any[]).map((c) => [c.id, c.name])));

function loadJson(filename: string) {
  try {
    const fp = path.join(process.cwd(), 'src', 'data', 'live', filename);
    if (fs.existsSync(fp)) return JSON.parse(fs.readFileSync(fp, 'utf-8'));
  } catch {}
  return null;
}

const d = loadJson('fleet_bot_hits.json');
const c = d?.ai_citations ?? null;
const win = d?.window_days ?? 30;

const total = c?.window_total_raw ?? 0;       // true ai-user fetches in window
const fresh = c?.fresh_24h ?? 0;              // the flag
const spoofed = c?.spoofed ?? 0;
const capped = c?.capped ?? false;
const bySite = (c?.by_site ?? []).slice(0, 12);
const topPages = (c?.top_pages ?? []).slice(0, 10);
const recent = (c?.recent ?? []).slice(0, 14);

const engColour: Record<string, string> = {
  openai: 'bg-emerald-500/20 text-emerald-300',
  perplexity: 'bg-sky-500/20 text-sky-300',
  anthropic: 'bg-violet-500/20 text-violet-300',
  mistral: 'bg-amber-500/20 text-amber-300',
};
const engChip = (e: string) => engColour[e] ?? 'bg-slate-700 text-slate-300';
const fmtDay = (s: string | null) => {
  if (!s) return '';
  try { return new Date(s).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }); } catch { return ''; }
};
const fmtTime = (s: string | null) => {
  if (!s) return '';
  try { return new Date(s).toLocaleString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }); } catch { return ''; }
};
const engineLabel = (s: any) => Object.keys(s.engines || {}).join(' · ');
---
<section class="rounded-xl bg-slate-900 text-slate-100 p-6 my-6 border border-slate-800">
  <div class="flex items-baseline justify-between flex-wrap gap-2 mb-1">
    <h2 class="text-lg font-bold flex items-center gap-2">
      AI Citations <span class="text-xs font-normal text-slate-400">(we were just fetched into an AI answer)</span>
      <span id="aic-live" title="Refreshed live from Supabase on load + every 60s" class="text-[10px] font-semibold text-slate-400 rounded px-1.5 py-0.5 bg-slate-800">snapshot</span>
    </h2>
    <span id="aic-24h-pill" class={`inline-flex items-center gap-1.5 rounded-full bg-rose-500/15 text-rose-300 text-xs font-semibold px-3 py-1 ${fresh > 0 ? '' : 'hidden'}`}>
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-400"></span>
      </span>
      <span id="aic-24h-pill-n">{fresh.toLocaleString()}</span> in last 24h
    </span>
  </div>

  {!c || total === 0 ? (
    <p class="text-sm text-slate-400 mt-3">No verified AI-citation fetches in the last {win} days yet.</p>
  ) : (
    <>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4 mb-5">
        <div class="rounded-lg bg-slate-800/60 p-3">
          <div class="text-2xl font-bold">{total.toLocaleString()}</div>
          <div class="text-xs text-slate-400">AI-answer fetches · {win}d</div>
        </div>
        <div class="rounded-lg bg-slate-800/60 p-3">
          <div class="text-2xl font-bold text-rose-300"><span id="aic-24h-stat">{fresh.toLocaleString()}</span></div>
          <div class="text-xs text-slate-400">last 24h</div>
        </div>
        <div class="rounded-lg bg-slate-800/60 p-3">
          <div class="text-2xl font-bold">{bySite.length}</div>
          <div class="text-xs text-slate-400">sites cited</div>
        </div>
        <div class="rounded-lg bg-slate-800/60 p-3">
          <div class="text-2xl font-bold text-slate-400">{spoofed.toLocaleString()}</div>
          <div class="text-xs text-slate-400">spoofed UAs blocked</div>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-5">
        <div data-ai-bysite data-period="24h">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-semibold text-slate-300">By site</h3>
            <div class="inline-flex rounded-lg bg-slate-800/70 p-0.5 text-xs" role="tablist" aria-label="Citation period">
              <button type="button" data-aiwin="24h" class="ai-win-btn rounded-md px-2.5 py-1 font-semibold">24h</button>
              <button type="button" data-aiwin="7d" class="ai-win-btn rounded-md px-2.5 py-1 font-semibold">Week</button>
              <button type="button" data-aiwin="30d" class="ai-win-btn rounded-md px-2.5 py-1 font-semibold">Month</button>
            </div>
          </div>
          <table class="w-full text-sm">
            <tbody>
              {bySite.map((s: any) => (
                <tr class="border-b border-slate-800/70">
                  <td class="py-1.5 pr-2 font-medium">{nameOf(s.site)}</td>
                  <td class="py-1.5 pr-2 text-right tabular-nums">
                    <span class="ai-c ai-c-24h">{(s.count_24h ?? 0).toLocaleString()}</span>
                    <span class="ai-c ai-c-7d hidden">{(s.count_7d ?? 0).toLocaleString()}</span>
                    <span class="ai-c ai-c-30d hidden">{(s.count_30d ?? s.count ?? 0).toLocaleString()}</span>
                  </td>
                  <td class="py-1.5 text-right">
                    {Object.keys(s.engines || {}).map((e: string) => (
                      <span class={`ml-1 rounded px-1.5 py-0.5 text-[10px] font-semibold ${engChip(e)}`}>{e}</span>
                    ))}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-slate-300 mb-2">Most-cited pages</h3>
          <ul class="text-sm space-y-1">
            {topPages.map((p: any) => (
              <li class="flex items-baseline gap-2 border-b border-slate-800/70 py-1">
                <span class="tabular-nums text-slate-400 w-10">×{p.count}</span>
                <span class="truncate"><span class="text-slate-400">{nameOf(p.site)}</span>{p.path}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <h3 class="text-sm font-semibold text-slate-300 mt-5 mb-2">Recent live fetches</h3>
      <div id="aic-recent" class="space-y-1">
        {recent.map((r: any) => (
          <div class="flex items-center gap-2 text-sm border-b border-slate-800/60 py-1">
            {r.fresh
              ? <span class="rounded bg-rose-500/20 text-rose-300 text-[10px] font-bold px-1.5 py-0.5">NEW</span>
              : <span class="w-9"></span>}
            <span class={`rounded px-1.5 py-0.5 text-[10px] font-semibold ${engChip(r.engine)}`}>{r.bot}</span>
            <span class="truncate flex-1"><span class="text-slate-400">{nameOf(r.site)}</span>{r.path}</span>
            <span class="text-xs text-slate-500 whitespace-nowrap">{fmtTime(r.created_at)}</span>
          </div>
        ))}
      </div>

      <p class="text-xs text-slate-500 mt-3">
        Verified against operator networks (OpenAI/Azure, Anthropic/AWS, Perplexity) — spoofed user-agents excluded.
        {capped && ` Breakdown sampled from the most recent 1,000 of ${total.toLocaleString()} fetches.`}
      </p>
    </>
  )}

  <style>
    .ai-win-btn { color: #94a3b8; transition: all .12s; }
    .ai-win-btn.active { background: #475569; color: #fff; }
  </style>
  <script is:inline>
    (function () {
      document.querySelectorAll('[data-ai-bysite]').forEach(function (box) {
        var btns = box.querySelectorAll('.ai-win-btn');
        function show(win) {
          box.setAttribute('data-period', win);
          btns.forEach(function (b) { b.classList.toggle('active', b.getAttribute('data-aiwin') === win); });
          box.querySelectorAll('.ai-c').forEach(function (s) {
            s.classList.toggle('hidden', !s.classList.contains('ai-c-' + win));
          });
        }
        btns.forEach(function (b) { b.addEventListener('click', function () { show(b.getAttribute('data-aiwin')); }); });
        show('24h');
      });
    })();
  </script>

  {/* LIVE feed — fetch /api/ai-citations (Pages Function -> Supabase) on load + every
      60s so the "recent fetches" + 24h count are actually live, not the daily snapshot. */}
  <script type="application/json" id="aic-names" set:html={idNameMap}></script>
  <script is:inline>
    (function () {
      var names = {};
      try { names = JSON.parse(document.getElementById('aic-names').textContent || '{}'); } catch (e) {}
      var nameOf = function (id) { return names[id] || id; };
      var engCol = { openai: 'background:rgba(16,185,129,.2);color:#6ee7b7', perplexity: 'background:rgba(14,165,233,.2);color:#7dd3fc', anthropic: 'background:rgba(139,92,246,.2);color:#c4b5fd', mistral: 'background:rgba(245,158,11,.2);color:#fcd34d' };
      function chip(e) { return engCol[e] || 'background:#334155;color:#cbd5e1'; }
      function ago(ts) { var d = (Date.now() - Date.parse(ts)) / 1000; if (isNaN(d)) return ''; if (d < 60) return Math.round(d) + 's ago'; if (d < 3600) return Math.round(d / 60) + 'm ago'; if (d < 86400) return Math.round(d / 3600) + 'h ago'; return Math.round(d / 86400) + 'd ago'; }
      function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }

      function paint(d) {
        var live = document.getElementById('aic-live');
        if (!d || !d.live) { if (live) { live.textContent = 'snapshot · daily'; } return; }
        if (live) { live.textContent = '● LIVE · updated now'; live.style.cssText = 'color:#6ee7b7;background:rgba(16,185,129,.15)'; }
        var s24 = document.getElementById('aic-24h-stat'); if (s24) s24.textContent = (d.total_24h || 0).toLocaleString();
        var pn = document.getElementById('aic-24h-pill-n'); var pill = document.getElementById('aic-24h-pill');
        if (pn) pn.textContent = (d.total_24h || 0).toLocaleString();
        if (pill) pill.classList.toggle('hidden', !(d.total_24h > 0));
        var box = document.getElementById('aic-recent');
        if (box && Array.isArray(d.recent)) {
          box.innerHTML = d.recent.map(function (r) {
            return '<div class="flex items-center gap-2 text-sm border-b border-slate-800/60 py-1">' +
              (r.fresh ? '<span class="rounded bg-rose-500/20 text-rose-300 text-[10px] font-bold px-1.5 py-0.5">NEW</span>' : '<span class="w-9"></span>') +
              '<span class="rounded px-1.5 py-0.5 text-[10px] font-semibold" style="' + chip(r.engine) + '">' + esc(r.bot) + '</span>' +
              '<span class="truncate flex-1"><span class="text-slate-400">' + esc(nameOf(r.site)) + '</span>' + esc(r.path) + '</span>' +
              '<span class="text-xs text-slate-500 whitespace-nowrap">' + ago(r.created_at) + '</span></div>';
          }).join('') || '<p class="text-sm text-slate-400">No verified AI fetches yet.</p>';
        }
      }
      function refresh() { fetch('/api/ai-citations', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(paint).catch(function () {}); }
      refresh();
      setInterval(refresh, 60000);
    })();
  </script>
</section>
