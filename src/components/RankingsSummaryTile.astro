---
/**
 * RankingsSummaryTile — compact per-site rankings overview for the homepage top.
 * Same GSC feed as /rankings/ (gsc.json top_queries, last 28d), board-filtered.
 * Shows avg position, page-1 / striking-distance counts, impressions + clicks per
 * site; links to the full Rankings page. Added 24 Jun (Adam: rankings near the top).
 */
import fs from 'node:fs';
import path from 'node:path';
import clients from '../utils/dashboardClients';

function loadJson(filename: string) {
  try {
    const fp = path.join(process.cwd(), 'src', 'data', 'live', filename);
    if (fs.existsSync(fp)) return JSON.parse(fs.readFileSync(fp, 'utf-8'));
  } catch {}
  return null;
}

const gsc = loadJson('gsc.json') || {};
const boardClients = clients as any[];
const clientIds = new Set(boardClients.map((c) => c.id));

const sites = boardClients
  .filter((c) => clientIds.has(c.id) && (gsc as any)[c.id]?.top_queries?.length)
  .map((c) => {
    const g = (gsc as any)[c.id] || {};
    const rows = (g.top_queries || []).filter((q: any) => q.query && q.impressions > 0);
    const impressions = rows.reduce((s: number, r: any) => s + (r.impressions || 0), 0);
    const clicks = rows.reduce((s: number, r: any) => s + (r.clicks || 0), 0);
    const page1 = rows.filter((r: any) => r.position <= 10).length;
    const striking = rows.filter((r: any) => r.position > 10 && r.position <= 20).length;
    return { id: c.id, name: c.name || c.id, avgPos: g.totals?.position, page1, striking, impressions, clicks };
  })
  .sort((a, b) => b.impressions - a.impressions);

const fleetImpr = sites.reduce((s, x) => s + x.impressions, 0);
const fleetClicks = sites.reduce((s, x) => s + x.clicks, 0);
const fleetPage1 = sites.reduce((s, x) => s + x.page1, 0);
const fmt = (n: number) => (n || 0).toLocaleString();
const posColor = (p: number) => p == null ? 'text-gray-500' : p <= 10 ? 'text-emerald-300' : p <= 20 ? 'text-amber-300' : 'text-gray-400';
---
{sites.length > 0 && (
  <section data-copy-tile="Rankings" class="rounded-xl bg-slate-900 border border-indigo-800/40 p-5 mb-6">
    <div class="flex items-center justify-between flex-wrap gap-2 mb-1">
      <div class="flex items-baseline gap-3">
        <h2 class="text-lg font-bold text-indigo-200">Rankings</h2>
        <span class="text-xs text-slate-400">
          <span class="text-emerald-300 font-bold">{fmt(fleetImpr)}</span> impressions ·
          <span class="text-emerald-300 font-bold">{fmt(fleetClicks)}</span> clicks ·
          <span class="text-emerald-300 font-bold">{fleetPage1}</span> on page 1 · last 28d
        </span>
      </div>
      <a href="/rankings/" class="text-xs text-indigo-300 hover:text-indigo-200 font-semibold">Full rankings →</a>
    </div>
    <div class="overflow-x-auto mt-3">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-slate-500 text-xs border-b border-slate-800">
            <th class="py-1.5 pr-2 font-medium">Site</th>
            <th class="py-1.5 px-2 text-right font-medium">Avg pos</th>
            <th class="py-1.5 px-2 text-right font-medium">Page 1</th>
            <th class="py-1.5 px-2 text-right font-medium">Striking</th>
            <th class="py-1.5 px-2 text-right font-medium">Impressions</th>
            <th class="py-1.5 pl-2 text-right font-medium">Clicks</th>
          </tr>
        </thead>
        <tbody>
          {sites.map((s) => (
            <tr class="border-b border-slate-800/70">
              <td class="py-1.5 pr-2">
                <a href={`/rankings/#${s.id}`} class="font-medium text-slate-200 hover:text-white">{s.name}</a>
              </td>
              <td class={`py-1.5 px-2 text-right tabular-nums ${posColor(s.avgPos)}`}>{s.avgPos != null ? Math.round(s.avgPos) : '—'}</td>
              <td class="py-1.5 px-2 text-right tabular-nums text-emerald-300">{s.page1}</td>
              <td class="py-1.5 px-2 text-right tabular-nums text-amber-300">{s.striking}</td>
              <td class="py-1.5 px-2 text-right tabular-nums">{fmt(s.impressions)}</td>
              <td class="py-1.5 pl-2 text-right tabular-nums">{fmt(s.clicks)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-[11px] text-slate-500 mt-2">Google position per tracked query (GSC) · 🟢 page 1 (≤10) · 🟡 striking distance (11–20).</p>
  </section>
)}
