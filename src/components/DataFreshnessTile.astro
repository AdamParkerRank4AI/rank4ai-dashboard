---
/**
 * DataFreshnessTile — loud "is the data current?" panel. Surfaces EVERY feed
 * (incl. the tier:auto research dumps the headline banner hides), each with its
 * last-run date + age + a stale flag, so nobody is misled by an old number and
 * it's obvious what needs re-running. Static board can't execute a refresh, so
 * the flag shows the exact command. Added 24 Jun (Adam: make staleness clear +
 * say last run on X + flag to run). Reads data_freshness.json.
 */
import fs from 'node:fs';
import path from 'node:path';

function loadJson(filename: string) {
  try {
    const fp = path.join(process.cwd(), 'src', 'data', 'live', filename);
    if (fs.existsSync(fp)) return JSON.parse(fs.readFileSync(fp, 'utf-8'));
  } catch {}
  return null;
}

const fr = loadJson('data_freshness.json');
const feeds = (fr?.feeds || []) as any[];
const summary = fr?.summary || {};
const checkedAt = fr?.checked_at
  ? new Date(fr.checked_at).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })
  : '—';

const rank = (s: string) => (s === 'missing' ? 0 : s === 'very_stale' ? 1 : s === 'stale' ? 2 : 3);
const stale = feeds
  .filter((f) => f.status === 'very_stale' || f.status === 'stale' || f.status === 'missing')
  .sort((a, b) => rank(a.status) - rank(b.status) || (b.age_hours || 0) - (a.age_hours || 0));

const fresh = summary.fresh ?? feeds.filter((f) => f.status === 'fresh').length;
const total = summary.total ?? feeds.length;
const badCount = stale.length;
const tone = badCount === 0 ? 'ok' : stale.some((f) => f.status !== 'stale') ? 'bad' : 'warn';
const toneRing = tone === 'bad' ? 'border-rose-700/60 bg-rose-950/30' : tone === 'warn' ? 'border-amber-700/60 bg-amber-950/30' : 'border-emerald-800/50 bg-emerald-950/20';
const toneText = tone === 'bad' ? 'text-rose-300' : tone === 'warn' ? 'text-amber-300' : 'text-emerald-300';

const lastRun = (f: any) => {
  if (!f.ts) return 'never run';
  let when = '';
  try { when = new Date(f.ts).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }); } catch { when = f.ts; }
  const ago = f.age_hours == null ? '' : f.age_hours >= 48 ? ` · ${Math.round(f.age_hours / 24)}d ago` : ` · ${Math.round(f.age_hours)}h ago`;
  return `last run ${when}${ago}`;
};
const flag = (s: string) => s === 'missing' ? 'NEVER RUN' : s === 'very_stale' ? 'VERY STALE' : 'STALE';
const flagCls = (s: string) => s === 'stale' ? 'bg-amber-500/20 text-amber-300' : 'bg-rose-500/20 text-rose-300';
---
<section data-copy-tile="Data freshness" class={`rounded-xl border p-4 mb-6 ${toneRing}`}>
  <div class="flex items-center justify-between flex-wrap gap-2">
    <div class="flex items-baseline gap-3">
      <h2 class={`text-sm font-bold uppercase tracking-wider ${toneText}`}>Data freshness</h2>
      <span class="text-xs text-slate-400">
        <span class="text-emerald-300 font-bold">{fresh}</span> fresh ·
        {badCount > 0
          ? <span class={`font-bold ${toneText}`}>{badCount} need a refresh</span>
          : <span class="text-emerald-300 font-bold">all current</span>}
        · checked {checkedAt}
      </span>
    </div>
    {badCount > 0 && (
      <code class="text-[11px] text-slate-300 bg-slate-900/70 border border-slate-700 rounded px-2 py-1">run: python3 scripts/refresh_all.py</code>
    )}
  </div>

  {badCount > 0 && (
    <details class="mt-3">
      <summary class="cursor-pointer text-xs text-slate-400 hover:text-slate-200 select-none list-none [&::-webkit-details-marker]:hidden">
        ▸ Show {badCount} stale feed{badCount > 1 ? 's' : ''} — last-run dates
      </summary>
      <div class="mt-2 max-h-72 overflow-y-auto pr-1">
        <table class="w-full text-xs">
          <tbody>
            {stale.map((f) => (
              <tr class="border-b border-slate-800/60">
                <td class="py-1 pr-2 font-medium text-slate-200">{f.label || f.file}</td>
                <td class="py-1 pr-2 text-slate-400 whitespace-nowrap">{lastRun(f)}</td>
                <td class="py-1 text-right">
                  <span class={`rounded px-1.5 py-0.5 text-[10px] font-bold ${flagCls(f.status)}`}>{flag(f.status)}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-[11px] text-slate-500 mt-2">
        Daily board feeds refresh automatically each morning. The feeds above are heavier / weekly research pulls
        (DataForSEO, SERP, Knowledge Graph, NLP, citation prompts) — run <code class="text-slate-300">refresh_all.py</code> to bring them current.
      </p>
    </details>
  )}
</section>
