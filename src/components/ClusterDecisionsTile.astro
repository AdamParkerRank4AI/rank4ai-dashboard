---
/**
 * ClusterDecisionsTile — the "join in the data layer".
 *
 * Groups URLs that fight over the same searches (SERP-overlap clusters, derived
 * from cannibalisation co-ranking data) and shows ONE decision per cluster:
 * Keep / Fix / Consolidate / Optimise / Prune — with evidence + confidence.
 *
 * Turns the dashboard's separate detectors (cannibalisation, decay, indexing)
 * into a single prioritised action list. Reads src/data/live/cluster_decisions.json
 * (written by scripts/build_cluster_decisions.py). Defensive against missing data.
 */
import fs from 'node:fs';
import path from 'node:path';
import clients from '../utils/dashboardClients';
const nameOf = (id) => ((clients as any[]).find((c) => c.id === id) || {}).name || id;

function loadJson(filename: string) {
  try {
    const filePath = path.join(process.cwd(), 'src', 'data', 'live', filename);
    if (fs.existsSync(filePath)) {
      return JSON.parse(fs.readFileSync(filePath, 'utf-8'));
    }
  } catch {}
  return null;
}

const data = loadJson('cluster_decisions.json') || { sites: {}, computed_at: null };
const clientIds = new Set((clients as any[]).map((c) => c.id));

// fleet sites only, with clusters
const sitesAll = Object.entries(data.sites || {})
  .filter(([id, s]: [string, any]) => clientIds.has(id) && (s.clusters || []).length);
// Only LIST clusters that need a decision. "Keep" = healthy/no-action, so it's
// summarised (count) not listed — otherwise the tile is mostly noise (Adam, 29 Jun).
const sites = sitesAll
  .map(([id, s]: [string, any]) => [id, s, (s.clusters || []).filter((c: any) => c.recommendation !== 'Keep')] as [string, any, any[]])
  .filter(([, , act]) => (act as any[]).length)
  .sort((a: any, b: any) => b[2].length - a[2].length);
const keptCount = sitesAll.reduce((n, [, s]: any) => n + (s.clusters || []).filter((c: any) => c.recommendation === 'Keep').length, 0);
const actionableCount = sites.reduce((n, [, , act]: any) => n + act.length, 0);

const computedAt = data.computed_at
  ? new Date(data.computed_at).toLocaleString('en-GB', {
      timeZone: 'Europe/London', day: '2-digit', month: 'short',
      hour: '2-digit', minute: '2-digit',
    })
  : null;

const REC_STYLE: Record<string, string> = {
  Consolidate: 'bg-amber-100 text-amber-800 border-amber-200',
  Fix: 'bg-red-100 text-red-800 border-red-200',
  Optimise: 'bg-blue-100 text-blue-800 border-blue-200',
  Prune: 'bg-gray-100 text-gray-600 border-gray-200',
  Keep: 'bg-green-100 text-green-800 border-green-200',
};
const short = (u: string) => u.replace(/^https?:\/\/(www\.)?[^/]+/, '') || '/';
---

<div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
  <div class="flex items-baseline justify-between mb-1">
    <h2 class="text-lg font-semibold text-gray-900">SERP cluster decisions</h2>
    {computedAt && <span class="text-xs text-gray-400">{computedAt}</span>}
  </div>
  <p class="text-xs text-gray-500 mb-4">
    URLs grouped by the searches they compete over → one call per cluster.
    Showing only clusters that need action (Fix / Consolidate / Optimise / Prune);
    <strong>{actionableCount}</strong> across {sites.length} sites.
    {keptCount > 0 && <span> {keptCount} more are healthy (Keep — no action).</span>}
  </p>

  {sites.length === 0 && (
    <p class="text-sm text-gray-400">
      {keptCount > 0
        ? `Nothing to action — all ${keptCount} clusters are healthy (Keep).`
        : 'No clusters yet — run scripts/build_cluster_decisions.py.'}
    </p>
  )}

  <div class="space-y-5">
    {sites.map(([siteId, s, act]: [string, any, any[]]) => (
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="text-sm font-semibold text-gray-800">{nameOf(siteId)}</span>
          <span class="text-xs text-gray-400">
            {act.length} to action
            {(s.clusters || []).length - act.length > 0 && ` · ${(s.clusters || []).length - act.length} kept`}
          </span>
        </div>
        <div class="space-y-2">
          {act.slice(0, 8).map((c: any) => (
            <div class="rounded-lg border border-gray-100 bg-gray-50/60 p-3">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class={`text-[11px] font-semibold px-2 py-0.5 rounded border ${REC_STYLE[c.recommendation] || 'bg-gray-100 text-gray-700 border-gray-200'}`}>
                      {c.recommendation}
                    </span>
                    <span class="text-[11px] text-gray-400 uppercase tracking-wide">{c.confidence}</span>
                    <span class="text-sm font-medium text-gray-900 truncate">{c.theme}</span>
                  </div>
                  <p class="text-xs text-gray-600 mt-1">{c.reason}</p>
                  <p class="text-[11px] text-gray-500 mt-1">
                    winner: <span class="font-mono">{short(c.winner)}</span>
                  </p>
                </div>
                <div class="text-right shrink-0 text-[11px] text-gray-500 leading-5">
                  <div>{c.total_impressions} imp</div>
                  <div>{c.n_urls} URLs</div>
                  <div>pos {c.best_position}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
